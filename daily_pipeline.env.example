# ==============================================================================
# Daily Trader Pipeline Configuration
# Copy this file to .env or export these environment variables in your shell/cron.
# ==============================================================================

# Database & Model Server
TRADER_DB_PATH=/home/erfontes/research/trader/market_data.db
GEMMA4_SERVER_URL=http://127.0.0.1:11434
GEMMA4_PYTHON_PATH=/home/erfontes/miniconda3/envs/vel/bin/python
GEMMA4_SCRIPT_PATH=/home/erfontes/research/trader/gemma4_server.py

# Target Tickers (comma-separated)
TARGET_TICKERS=GOOGL,NVDA,COST,TSLA,AMD
BENCHMARK_TICKERS=^VIX,SPY,QQQ

# Email Dispatch Configuration (SMTP)
# Leave blank to save report locally as latest_daily_briefing.html without sending email.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_specific_password
ALERT_EMAIL_FROM=your_email@gmail.com
ALERT_EMAIL_TO=erfontes@gmail.com
